      "ambientText": "Map cases line the wall. The speaker does not look at you when he speaks.",
      "clues": [
        {
          "label": "Enigma cipher chart",
          "detail": "A wall chart of rotor orders and plugboard swaps, annotated in three different hands. Two of the annotations are later than the war.",
          "x": 0.28,
          "y": 0.52,
          "figureQuote": "He wrote for me this document; I keep it still. Britain was his office before it was mine.",
          "index": 1,
          "sceneIndex": 0
        },
        {
          "label": "A dispatch, unsigned",
          "detail": "No signature, no seal. It asks for one more month of funding and signs off on a machine that does not yet exist.",
          "x": 0.72,
          "y": 0.44,
          "figureQuote": "He wrote for me this document when Britain was theirs. I learned the room before I learned the work.",
          "index": 2,
          "sceneIndex": 0
        }
