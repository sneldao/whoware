      "ambientText": "The room is warm and entirely ordinary. This is where it ends badly.",
      "clues": [
        {
          "label": "A typescript on computable numbers",
          "detail": "Typed by hand on a machine that reads left to right, in a subject that had no name yet. The argument is complete and cannot be finished.",
          "x": 0.5,
          "y": 0.55,
          "figureQuote": "He gave me this, and I think of him when I see it. The office remembers him longer than people do.",
          "index": 1,
          "sceneIndex": 2
        },
        {
          "label": "A coroner's finding",
          "detail": "One page. Cause of death given plainly. A postscript notes that prosecution, not the sentence, had done the killing.",
          "x": 0.66,
          "y": 0.62,
          "figureQuote": "He gave me this; I think of him when I see it. Britain was his office before it was mine.",
          "index": 2,
